# mqvpn server configuration
# Copy to /etc/mqvpn/server.conf and edit as needed.

[Interface]
Listen = 0.0.0.0:443
Subnet = 10.0.0.0/24
# Subnet6 = fd00:abcd::/112
TunName = mqvpn0
LogLevel = info
# MTU = 1280                   # TUN MTU (1280–9000, default: auto = ~1382)

[TLS]
Cert = /etc/mqvpn/server.crt
Key = /etc/mqvpn/server.key

[Auth]
# Generate with: mqvpn --genkey
Key = <YOUR_PSK_HERE>
MaxClients = 64

[Multipath]
# Scheduler: wlb (weighted load balancing) or minrtt (lowest RTT)
Scheduler = wlb
# CC = bbr2                     # Congestion control (bbr2|bbr|cubic|none)

# [Proxy]
# Optional Linux-only QUIC SNI routing and HTTP/3-to-h2c proxy. Disabled by
# default. See the "Server fallback proxy" guide for backend requirements.
# Enabled = false
# SNI = vpn.example.com,*.edge.example
# QuicFallback = 127.0.0.1:4443
# QuicFallbackProxyProtocol = true
# Http2Backend = 127.0.0.1:8080
# Http2BackendTLS = false
# MaxConnections = 64
# IdleTimeoutSec = 60

# [Control]
# Local-only TCP control/admin API (add/remove users, query stats).
# Uncomment to enable. No authentication — bind 127.0.0.1 only unless you
# place it behind a reverse proxy / SSH tunnel / firewall.
# Listen = 127.0.0.1:9090
