From: r11234567 <noreply@github.com>
Date: Sun, 2 Aug 2026 14:00:00 +0200
Subject: [PATCH] Harden parser bounds and allocation failures

Fix the actionable findings reported while xquic was included in mqvpn's
CodeQL database. Keep the changes as a downstream patch until they can be
submitted to and released by xquic.

diff --git a/src/common/utils/var_buf/xqc_var_buf.c b/src/common/utils/var_buf/xqc_var_buf.c
--- a/src/common/utils/var_buf/xqc_var_buf.c
+++ b/src/common/utils/var_buf/xqc_var_buf.c
@@ -116,6 +116,11 @@ xqc_int_t
 xqc_var_buf_reduce(xqc_var_buf_t *buf)
 {
-    uint64_t capacity = xqc_pow2_upper(buf->data_len - buf->consumed_len);
+    if (buf->consumed_len > buf->data_len) {
+        return -XQC_EPARAM;
+    }
+
+    size_t remaining = buf->data_len - buf->consumed_len;
+    uint64_t capacity = xqc_pow2_upper(remaining);
     if (capacity == XQC_POW2_UPPER_ERROR) {
         return -XQC_EPARAM;
     }
@@ -130,15 +135,15 @@ xqc_var_buf_reduce(xqc_var_buf_t *buf)
     }
 
     if (buf->data != NULL && buf->buf_len > 0) {
-        if (buf->data_len - buf->consumed_len > 0) {
-            memcpy(new_data, buf->data + buf->consumed_len, buf->data_len - buf->consumed_len);
+        if (remaining > 0) {
+            memcpy(new_data, buf->data + buf->consumed_len, remaining);
         }
         xqc_free(buf->data);
     }
 
     buf->data = new_data;
     buf->buf_len = capacity;
-    buf->data_len -= buf->consumed_len;
+    buf->data_len = remaining;
     buf->consumed_len = 0;
 
     return XQC_OK;
diff --git a/src/http3/qpack/xqc_prefixed_str.c b/src/http3/qpack/xqc_prefixed_str.c
--- a/src/http3/qpack/xqc_prefixed_str.c
+++ b/src/http3/qpack/xqc_prefixed_str.c
@@ -31,6 +31,9 @@ xqc_prefixed_str_t *
 xqc_prefixed_str_pctx_create(size_t capacity)
 {
     xqc_prefixed_str_t *pctx = xqc_malloc(sizeof(xqc_prefixed_str_t));
+    if (pctx == NULL) {
+        return NULL;
+    }
     memset(pctx, 0, sizeof(xqc_prefixed_str_t));
 
     pctx->value = xqc_var_buf_create(capacity);
