  */
 
-#ifndef _XQC_SCHEDULER_MINRTT_H_INCLUDED_
-#define _XQC_SCHEDULER_MINRTT_H_INCLUDED_
+#ifndef _XQC_SCHEDULER_RAP_H_INCLUDED_
+#define _XQC_SCHEDULER_RAP_H_INCLUDED_
 
 #include <xquic/xquic_typedef.h>
 #include <xquic/xquic.h>
diff --git a/src/transport/xqc_conn.c b/src/transport/xqc_conn.c
--- a/src/transport/xqc_conn.c
